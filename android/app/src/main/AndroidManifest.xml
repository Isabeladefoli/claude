<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- O app precisa de internet pra falar com o servidor. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Gravar áudio (mensagens de voz). Pedimos ao usuário na hora de gravar. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Notificações push. Android 13+ exige permissão explícita. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:label="Private Messenger"
        android:supportsRtl="true"
        android:theme="@style/Theme.PrivateMessenger"
        android:usesCleartextTraffic="true">
        <!-- usesCleartextTraffic=true permite conectar em http:// (servidor local
             durante o desenvolvimento). Em produção, via Cloudflare, tudo é
             https:// e isso deixa de ser necessário. -->

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Serviço que recebe notificações push do Firebase. -->
        <service
            android:name=".firebase.MessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
