        <string name="Name">LightingSetup</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- LightingSetup.server.luau  ->  vai em ServerScriptService
-- =========================================================================
-- Dá aquele visual "uau" de jogo profissional: céu bonito, atmosfera,
-- brilho (bloom) e correção de cor. Sem isso o jogo fica com cara de
-- Baseplate cru; com isso fica com cara de jogo de verdade. ✨
-- =========================================================================

local Lighting = game:GetService("Lighting")

-- horário/tom geral — clima de FLORESTA 🌿
Lighting.ClockTime = 13 -- sol alto, luz entrando entre as folhas
Lighting.Brightness = 2
Lighting.ExposureCompensation = 0
Lighting.Ambient = Color3.fromRGB(70, 85, 70) -- sombra esverdeada
Lighting.OutdoorAmbient = Color3.fromRGB(120, 140, 110) -- luz com tom de mata
Lighting.EnvironmentDiffuseScale = 0.6
Lighting.EnvironmentSpecularScale = 0.6
Lighting.GlobalShadows = true

-- limpa efeitos antigos pra não duplicar se rodar de novo
for _, obj in Lighting:GetChildren() do
	if obj:IsA("PostEffect") or obj:IsA("Atmosphere") or obj:IsA("Sky") then
		obj:Destroy()
	end
end

-- atmosfera — neblina esverdeada de floresta ao fundo 🌫️
local atmosphere = Instance.new("Atmosphere")
atmosphere.Density = 0.36
atmosphere.Offset = 0.1
atmosphere.Color = Color3.fromRGB(180, 205, 175)
atmosphere.Decay = Color3.fromRGB(90, 120, 80)
atmosphere.Glare = 0
atmosphere.Haze = 1.6
atmosphere.Parent = Lighting

-- brilho SÓ nas partes bem neon (moedas, lava, chegada), sem lavar a tela
local bloom = Instance.new("BloomEffect")
bloom.Intensity = 0.35 -- (era 0.8 — brilho controlado agora)
bloom.Size = 20
bloom.Threshold = 1.1 -- só o que é MUITO brilhante ganha o glow
bloom.Parent = Lighting

-- correção de cor: deixa as cores mais vivas sem exagerar
local cc = Instance.new("ColorCorrectionEffect")
cc.Brightness = 0
cc.Contrast = 0.08
cc.Saturation = 0.12
cc.TintColor = Color3.fromRGB(255, 252, 248)
cc.Parent = Lighting

-- leve profundidade de campo pra dar aquele charme cinematográfico
local dof = Instance.new("DepthOfFieldEffect")
dof.FarIntensity = 0.15
dof.FocusDistance = 30
dof.InFocusRadius = 60
dof.NearIntensity = 0
dof.Parent = Lighting
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="4">
      <Properties>
        <string name="Name">VineGrab</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- VineGrab.server.luau  ->  vai em ServerScriptService
-- =========================================================================
-- Faz o cipó (parte marcada com "Grabbable") ser AGARRÁVEL:
--   * Encoste no cipó  -> seu personagem se pendura e começa a balançar
--   * Aperte ESPAÇO    -> solta e é lançado com o embalo (dá pra "voar")
--
-- Funciona com qualquer parte marcada "Grabbable", então dá pra criar vários
-- cipós depois. 🌿
-- =========================================================================

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- RemoteEvent que o cliente usa pra avisar "quero soltar" (ao apertar espaço)
local releaseEvent = ReplicatedStorage:FindFirstChild("VineRelease") :: RemoteEvent?
if not releaseEvent then
	releaseEvent = Instance.new("RemoteEvent")
	releaseEvent.Name = "VineRelease"
	releaseEvent.Parent = ReplicatedStorage
end

type Hold = {
	vine: BasePart,
	weld: Weld,
	humanoid: Humanoid,
	hrp: BasePart,
}

local holding: { [Player]: Hold } = {}
local cooldownUntil: { [Player]: number } = {}

-- solta o cipó, devolvendo o controle e mantendo o embalo (impulso)
local function release(player: Player)
	local hold = holding[player]
	if not hold then
		return
	end
	holding[player] = nil

	local hrp = hold.hrp
	local momentum = hrp.AssemblyLinearVelocity

	hold.weld:Destroy()
	hold.humanoid.PlatformStand = false

	-- devolve a "posse" física do cipó pro servidor
	pcall(function()
		hold.vine:SetNetworkOwner(nil)
	end)

	-- aplica o embalo do balanço + um empurrãozinho pra cima = pulo estiloso
	hrp.AssemblyLinearVelocity = momentum + Vector3.new(0, 22, 0)

	cooldownUntil[player] = os.clock() + 1.0
end

-- agarra o cipó
local function grab(player: Player, vine: BasePart, character: Model)
	if holding[player] then
		return
	end
	if os.clock() < (cooldownUntil[player] or 0) then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local hrp = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not humanoid or not hrp or humanoid.Health <= 0 then
		return
	end

	-- posiciona o personagem pendurado logo abaixo da ponta de baixo do cipó
	local bottom = vine.CFrame * CFrame.new(-(vine.Size.X / 2), 0, 0) -- ponta inferior
	local hangCFrame = CFrame.new(bottom.Position - Vector3.new(0, 2.5, 0))
	hrp.CFrame = hangCFrame

	-- entrega o controle físico do cipó pro cliente do jogador (balanço fluido)
	pcall(function()
		vine:SetNetworkOwner(player)
	end)

	-- prende o personagem no cipó
	local weld = Instance.new("Weld")
	weld.Part0 = vine
	weld.Part1 = hrp
	weld.C0 = vine.CFrame:ToObjectSpace(hrp.CFrame)
	weld.Parent = vine

	humanoid.PlatformStand = true -- desliga o andar; a física do cipó comanda

	-- empurrãozinho inicial na direção pra onde o jogador olha, pra já balançar
	local look = hrp.CFrame.LookVector
	vine.AssemblyLinearVelocity = Vector3.new(look.X, 0, look.Z).Unit * 14

	holding[player] = {
		vine = vine,
		weld = weld,
		humanoid = humanoid,
		hrp = hrp,
	}
end

-- liga o "detector de toque" num cipó
local function connectVine(vine: BasePart)
	vine.Touched:Connect(function(hit)
		local character = hit.Parent :: Model?
		if not character then
			return
		end
		local player = Players:GetPlayerFromCharacter(character)
		if player then
			grab(player, vine, character)
		end
	end)
end

for _, inst in CollectionService:GetTagged("Grabbable") do
	if inst:IsA("BasePart") then
		connectVine(inst)
	end
end
CollectionService:GetInstanceAddedSignal("Grabbable"):Connect(function(inst)
	if inst:IsA("BasePart") then
		connectVine(inst)
	end
end)

-- pedido de soltar (veio do cliente ao apertar espaço)
releaseEvent.OnServerEvent:Connect(function(player)
	release(player)
end)

-- limpeza: se morrer ou sair enquanto pendurado, solta e limpa
Players.PlayerRemoving:Connect(function(player)
	holding[player] = nil
	cooldownUntil[player] = nil
end)
Players.PlayerAdded:Connect(function(player)
	player.CharacterRemoving:Connect(function()
		holding[player] = nil
	end)
end)
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="5">
      <Properties>
        <string name="Name">World</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- World.server.luau  ->  vai em ServerScriptService
-- =========================================================================
-- Monta a cena: chão de grama, uma ÁRVORE caprichada e um CIPÓ pendurado
-- num galho, pronto pra você se segurar e balançar.
--
-- A lógica de "agarrar / soltar" o cipó fica no VineGrab.server.luau.
-- =========================================================================

local CollectionService = game:GetService("CollectionService")

-- cores naturais
local BARK = Color3.fromRGB(92, 62, 41)
local BARK_DARK = Color3.fromRGB(72, 48, 32)
local LEAF_A = Color3.fromRGB(60, 110, 45)
local LEAF_B = Color3.fromRGB(84, 142, 58)
local LEAF_C = Color3.fromRGB(104, 168, 74)
local VINE_COLOR = Color3.fromRGB(74, 120, 52)

local world = Instance.new("Folder")
world.Name = "World"
world.Parent = workspace

-- helper de bloco genérico
local function make(class: string, props: { [string]: any }): Instance
	local inst = Instance.new(class)
	for k, v in props do
		(inst :: any)[k] = v
	end
	inst.Parent = props.Parent or world
	return inst
end

local function cylinder(size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material): BasePart
	return make("Part", {
		Shape = Enum.PartType.Cylinder,
		Size = size,
		CFrame = cframe,
		Color = color,
		Material = material,
		Anchored = true,
		TopSurface = Enum.SurfaceType.Smooth,
		BottomSurface = Enum.SurfaceType.Smooth,
	}) :: BasePart
end

local function blob(size: Vector3, pos: Vector3, color: Color3): BasePart
	return make("Part", {
		Shape = Enum.PartType.Ball,
		Size = size,
		Position = pos,
		Color = color,
		Material = Enum.Material.Grass,
		Anchored = true,
		CanCollide = false,
	}) :: BasePart
end

-- ======================================================================
--  CHÃO
-- ======================================================================
make("Part", {
	Name = "Ground",
	Size = Vector3.new(200, 4, 200),
	Position = Vector3.new(0, -2, 0),
	Color = Color3.fromRGB(86, 138, 62),
	Material = Enum.Material.Grass,
	Anchored = true,
})

-- ponto de nascimento
make("SpawnLocation", {
	Size = Vector3.new(8, 1, 8),
	Position = Vector3.new(0, 0.5, 18),
	Color = Color3.fromRGB(110, 165, 85),
	Material = Enum.Material.Grass,
	Anchored = true,
})

-- ======================================================================
--  A ÁRVORE 🌳
-- ======================================================================
local treeBase = Vector3.new(0, 0, 0)

-- tronco: cilindros empilhados que vão afinando (dá a impressão de tronco real)
local trunkSections = {
	{ y = 3, r = 4.0 },
	{ y = 9, r = 3.4 },
	{ y = 15, r = 2.8 },
	{ y = 20, r = 2.2 },
}
for _, s in trunkSections do
	-- cilindro em pé = girar 90° no eixo Z (o comprimento do cilindro é o eixo X)
	local height = 7
	cylinder(
		Vector3.new(height, s.r * 2, s.r * 2),
		CFrame.new(treeBase + Vector3.new(0, s.y, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		s.y < 12 and BARK or BARK_DARK,
		Enum.Material.Wood
	)
end

-- raízes na base (pequenos cilindros inclinados saindo do tronco)
for i = 0, 5 do
	local ang = math.rad(i * 60)
	local dir = Vector3.new(math.cos(ang), 0, math.sin(ang))
	local rootPos = treeBase + dir * 4 + Vector3.new(0, 0.6, 0)
	cylinder(
		Vector3.new(5, 1.6, 1.6),
		CFrame.new(rootPos, rootPos + dir + Vector3.new(0, -0.4, 0)) * CFrame.Angles(0, math.rad(90), 0),
		BARK_DARK,
		Enum.Material.Wood
	)
end

-- galhos principais saindo do alto do tronco
local branches = {
	{ dir = Vector3.new(1, 0.5, 0.2), len = 12 },
	{ dir = Vector3.new(-0.8, 0.6, -0.3), len = 11 },
	{ dir = Vector3.new(0.1, 0.7, 1), len = 10 },
	{ dir = Vector3.new(-0.2, 0.6, -1), len = 9 },
}
for _, b in branches do
	local dir = b.dir.Unit
	local start = treeBase + Vector3.new(0, 20, 0)
	local finish = start + dir * b.len
	local mid = (start + finish) / 2
	cylinder(
		Vector3.new(b.len, 1.8, 1.8),
		CFrame.new(mid, finish) * CFrame.Angles(0, math.rad(90), 0),
		BARK,
		Enum.Material.Wood
	)
end

-- galho FORTE e mais horizontal, de onde o cipó vai pendurar
local vineBranchStart = treeBase + Vector3.new(0, 22, 0)
local vineBranchEnd = vineBranchStart + Vector3.new(9, 1.5, 0)
cylinder(
	Vector3.new(11, 2.2, 2.2),
	CFrame.new((vineBranchStart + vineBranchEnd) / 2, vineBranchEnd) * CFrame.Angles(0, math.rad(90), 0),
	BARK,
	Enum.Material.Wood
)

-- COPA: várias bolotas de folha em tons diferentes (parece folhagem de verdade)
local canopyCenter = treeBase + Vector3.new(0, 26, 0)
local leafBlobs = {
	{ Vector3.new(0, 0, 0), 18, LEAF_B },
	{ Vector3.new(7, -2, 4), 13, LEAF_A },
	{ Vector3.new(-7, -1, -3), 13, LEAF_C },
	{ Vector3.new(4, 3, -6), 12, LEAF_C },
	{ Vector3.new(-5, 2, 6), 12, LEAF_A },
	{ Vector3.new(0, 5, 0), 12, LEAF_B },
	{ Vector3.new(9, 1, -2), 10, LEAF_B },
}
for _, lb in leafBlobs do
	local off, d, col = lb[1] :: Vector3, lb[2] :: number, lb[3] :: Color3
	blob(Vector3.new(d, d, d), canopyCenter + off, col)
end

-- ======================================================================
--  O CIPÓ 🌿  (pendura no galho e balança como um pêndulo)
-- ======================================================================
-- ponto fixo no galho (âncora do cipó)
local vineTopPos = Vector3.new(7, 21, 0)
local pivot = make("Part", {
	Name = "VinePivot",
	Size = Vector3.new(1, 1, 1),
	Position = vineTopPos,
	Anchored = true,
	Transparency = 1,
	CanCollide = false,
}) :: BasePart
local pivotAtt = make("Attachment", { Parent = pivot }) :: Attachment

-- o cipó em si: um cilindro comprido, SOLTO, preso ao pivô por uma junta de
-- "rótula" (BallSocket), que deixa ele balançar livre em qualquer direção.
local vineLength = 13
local vine = make("Part", {
	Name = "Vine",
	Shape = Enum.PartType.Cylinder,
	Size = Vector3.new(vineLength, 0.6, 0.6),
	-- posiciona o cipó pendurado pra baixo a partir do pivô
	CFrame = CFrame.new(vineTopPos - Vector3.new(0, vineLength / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
	Color = VINE_COLOR,
	Material = Enum.Material.Grass,
	Anchored = false,
	CanCollide = false,
}) :: BasePart

-- attachment no TOPO do cipó (lembre: o comprimento é o eixo X local)
local vineTopAtt = make("Attachment", {
	Parent = vine,
	Position = Vector3.new(vineLength / 2, 0, 0),
}) :: Attachment

-- junta de rótula: liga o topo do cipó ao pivô fixo -> vira um pêndulo
make("BallSocketConstraint", {
	Parent = vine,
	Attachment0 = pivotAtt,
	Attachment1 = vineTopAtt,
})

-- marca o cipó com uma tag pro script de agarrar reconhecer
CollectionService:AddTag(vine, "Grabbable")

-- folhinhas decorativas no cipó
for i = 1, 3 do
	blob(Vector3.new(2, 2, 2), vineTopPos - Vector3.new(0, i * 3.5, 0), LEAF_A)
end

print("[Cena] 🌳 Árvore e cipó prontos! Encoste no cipó pra se pendurar e pule pra soltar.")
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="6">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="7">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="8">
        <Properties>
          <string name="Name">VineClient</string>
          <string name="Source"><![CDATA[--!strict
-- VineClient.client.luau  ->  vai em StarterPlayer > StarterPlayerScripts
-- =========================================================================
-- Duas coisas:
--   1. Quando você aperta ESPAÇO (pulo), avisa o servidor pra SOLTAR o cipó.
--   2. Mostra uma dica na tela explicando os controles.
-- =========================================================================

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local releaseEvent = ReplicatedStorage:WaitForChild("VineRelease") :: RemoteEvent

-- avisa o servidor sempre que o jogador tenta pular (espaço / botão de pulo)
UserInputService.JumpRequest:Connect(function()
	releaseEvent:FireServer()
end)

-- ---- dica na tela ----
local gui = Instance.new("ScreenGui")
gui.Name = "VineHintGui"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local hint = Instance.new("TextLabel")
hint.AnchorPoint = Vector2.new(0.5, 1)
hint.Position = UDim2.new(0.5, 0, 0.95, 0)
hint.Size = UDim2.new(0, 440, 0, 44)
hint.BackgroundColor3 = Color3.fromRGB(20, 30, 18)
hint.BackgroundTransparency = 0.25
hint.TextColor3 = Color3.fromRGB(235, 255, 230)
hint.Font = Enum.Font.GothamMedium
hint.TextScaled = true
hint.Text = "🌿 Encoste no cipó para se pendurar  •  Espaço para soltar"
hint.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = hint

local pad = Instance.new("UIPadding")
pad.PaddingLeft = UDim.new(0, 14)
pad.PaddingRight = UDim.new(0, 14)
pad.Parent = hint
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
</roblox>